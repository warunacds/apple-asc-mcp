{
  "name": "apple-asc-mcp",
  "version": "0.2.0",
  "description": "Model Context Protocol server that lets Claude Code drive App Store Connect end-to-end (build, upload, metadata, screenshots, submission).",
  "license": "MIT",
  "author": "apple-asc-mcp contributors",
  "homepage": "https://github.com/warunacds/apple-asc-mcp#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/warunacds/apple-asc-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/warunacds/apple-asc-mcp/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "claude",
    "claude-code",
    "app-store-connect",
    "ios",
    "macos",
    "tvos",
    "visionos",
    "xcode",
    "xcodebuild",
    "altool",
    "transporter",
    "testflight",
    "release-automation"
  ],
  "type": "module",
  "bin": {
    "apple-asc-mcp": "./dist/index.js"
  },
  "files": [
    "dist",
    "examples",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "diagnose": "node dist/index.js --diagnose",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "prepublishOnly": "npm run typecheck && npm run build && npm test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.18.0",
    "jose": "^5.10.0",
    "zod": "^3.25.0",
    "zod-to-json-schema": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
